# 複製為 .env 後填入實際值（.env 已被 .gitignore 排除，絕不追蹤）

# PostgreSQL（Phase 0 起必要；正式站是 Coolify 上的內部連線字串）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# 幹部登入 session 簽章金鑰（Phase 4 起必要，≥16 字元；正式環境務必用長亂數）
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# env 引導管理員（可選，但方便）：設了這兩個即可用此帳密登入 admin，密碼放環境變數好找好改。
# 也可改用 npm run auth:create 建 DB 帳號；兩者可並存。
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudflare R2（Phase 5 檢核文件上傳）
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# LLM 加強層（可選；留空＝關閉，免費規則層不受影響）
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# LINE 會前提醒（2026-11，lib/line/；可選，留空＝關閉，其他功能不受影響）
# token 與 secret 在 LINE Developers 該 Messaging API channel 的設定頁。兩個都有才啟用。
# 發送群組不寫在這裡：機器人加進群組後，到後台 /console/line 選定。
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
# 排程呼叫 /api/line/dispatch 用的密鑰（16 字以上；沒設＝排程端點關閉）
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LINE_CRON_SECRET=""
# 只給本機測試：把 LINE API 指到模擬伺服器（NODE_ENV=production 時不生效，正式站不要設）
# LINE_API_BASE="http://127.0.0.1:3199"

# Google 日曆（尚未實作）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
