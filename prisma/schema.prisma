// 資料模型依 ARCHITECTURE.md「1. 統一資料模型」+ 2B + 2C。
// 變更模型請先對照 ARCHITECTURE.md，不要自行擴充範圍。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 法規結構（查詢／檢核／時程 共用）──

model Law {
  id            String             @id @default(cuid())
  category      String // 最高章程 / 行政 / 立法 / 司法 / 選舉
  number        String // "0.0" "1.10"
  name          String
  session       Int // 屆別，現行=20
  isCurrent     Boolean            @default(true)
  currentDate   DateTime?
  currentType   String? // 修正 / 訂定
  preamble      String?            @db.Text
  sourceFile    String? // 原始 PDF 檔名，供人工覆核
  chapters      Json? // 章結構完整標題陣列，如 [{title:"第一章 總則"}]；資料保真存完整，顯示層再排版
  articles      Article[]
  amendments    AmendmentHistory[]
  scheduleRules ScheduleRule[]

  @@unique([session, number])
  @@index([category])
}

model Article {
  id        String                      @id @default(cuid())
  lawId     String
  law       Law                         @relation(fields: [lawId], references: [id])
  number    String // "16" "3-1"
  name      String? // 條名
  chapter   String? // 第一章
  body      String                      @db.Text // 純文字全文（款項以換行合併，供搜尋/顯示）
  items     Json // 結構化款項陣列（string[]）
  version   Int                         @default(20) // = session，供跨屆 diff
  tsv       Unsupported("tsvector")? // 應用端斷詞後寫入（Phase 2）
  embedding Unsupported("vector(384)")? // 語意向量：@xenova multilingual-e5-small（Phase 2 可選層）

  @@unique([lawId, number])
  @@index([lawId])
}

model AmendmentHistory {
  id          String   @id @default(cuid())
  lawId       String
  law         Law      @relation(fields: [lawId], references: [id])
  date        DateTime
  roc         String // "113.09.19"
  sessionTerm String? // 屆別
  action      String // 修正 / 訂定 / 新增
  text        String   @db.Text

  @@index([lawId])
}

model LawReference {
  id            String  @id @default(cuid())
  fromLawId     String
  fromArticleNo String?
  toLawName     String // 被引用法規名（可能語料外，如《大學法》）
  toLawId       String? // 可解析到語料內時才有
  toArticleNo   String?
  kind          String // cite / 準用 / 牴觸 / 另訂
  raw           String // 原文片段

  @@index([fromLawId])
  @@index([toLawId])
}

// ── 時程管理（2C）──

enum ScheduleType {
  RECURRING
  RELATIVE
  ABSOLUTE
}

model ScheduleRule {
  id          String          @id @default(cuid())
  lawId       String
  law         Law             @relation(fields: [lawId], references: [id])
  articleNo   String // 來源條號，可回溯法源
  title       String // 人類可讀：「議會常會（每月一次）」
  type        ScheduleType
  rrule       String? // RECURRING：RRULE/cron，如每月
  anchorEvent String? // RELATIVE：錨定事件碼，如 MEETING_OPEN / PROPOSAL_PASSED
  offsetValue Int? // RELATIVE：3 / 14 / 30
  offsetUnit  String? // day / workday / month / hour
  direction   String? // before / after
  fixedMonth  Int? // ABSOLUTE：7
  fixedDay    Int? // ABSOLUTE：1
  audience    String? // 議會 / 行政中心 / 財委會…
  rawClause   String          @db.Text
  verified    Boolean         @default(false) // 人工確認過才啟用
  events      ScheduleEvent[]
}

model ScheduleEvent {
  id        String       @id @default(cuid())
  ruleId    String
  rule      ScheduleRule @relation(fields: [ruleId], references: [id])
  title     String
  dueAt     DateTime
  anchorAt  DateTime? // RELATIVE：錨定事件實際發生時間
  status    String       @default("scheduled")
  reminders Reminder[]
}

model Reminder {
  id      String        @id @default(cuid())
  eventId String
  event   ScheduleEvent @relation(fields: [eventId], references: [id])
  channel String // inapp / email / gcal / line
  fireAt  DateTime
  sentAt  DateTime?
  target  String? // email 位址 / LINE group id
}

// ── 合法性檢核（2B）──

model ComplianceCheck {
  id              String   @id @default(cuid())
  userId          String?
  inputType       String // proposal / activity_budget / freeform
  inputText       String   @db.Text
  fileUrl         String? // R2
  mode            String // rule_only（免費層）/ llm（加強層）
  model           String? // 走 LLM 時記錄用哪個（gemini-flash / claude-sonnet-5…）
  matchedArticles Json // 檢索對照撈到的相關條文 + 命中理由
  ruleFlags       Json // 規則清單觸發的旗標
  verdict         String? // compliant / concerns / non_compliant / insufficient（rule_only 時可為 null）
  confidence      Float?
  citations       Json // [{lawId, articleNo, quote, relation}]
  concerns        Json
  reviewedBy      String? // 人工覆核留痕（人在迴路）
  createdAt       DateTime @default(now())
}

// ── 幹部帳號（email 白名單，勿上重型 auth）──

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         String    @default("officer") // admin / officer / viewer
  passwordHash String? // scrypt（lib/auth/password.ts）；null＝白名單已建但尚未設密碼，不得登入
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ── 會議營運模組（Phase 4，見 MEETINGS-MODULE.md）──
// 幹部後台，全部掛在 (dashboard)/console 之下，需登入。收件人名單屬個資，永不進公開路由。

enum MeetingKind {
  REGULAR // 常會
  SPECIAL // 臨時會
  COMMITTEE // 委員會 / 校級會議代表委員會
}

enum MeetingStatus {
  DRAFT // 建置中（尚未發通知）
  NOTICED // 已發開會通知
  HELD // 已召開
  CLOSED // 已結案
}

model Meeting {
  id               String             @id @default(cuid())
  slug             String?            @unique // 語意網址段（21-115-1-0827-special）；見 lib/meetings/slug.ts。
  //                                          刻意可為 NULL：舊資料未回填時仍以 cuid 開得起來，
  //                                          避免「先部署 code 後跑 migration」順序反了就整頁 500。
  session          Int // 屆別，如 21
  academicYear     String // 「114學年度第2學期」
  name             String // 「七月議會臨時會」
  kind             MeetingKind        @default(REGULAR)
  meetingAt        DateTime // 會議時間
  location         String? // 「線上視訊會議室」
  meetingUrl       String? // Google Meet 連結
  docNumber        String? // 東議字第1140246號
  proposalDeadline DateTime? // 提案截止
  notes            String?            @db.Text // 備註一、二…
  status           MeetingStatus      @default(DRAFT)
  isPublic         Boolean            @default(false) // admin 逐場開；true 才出現在免登入公開頁
  // ── 現場議事（開會系統）。狀態全部由人操作推進，不得以時鐘自動推算。 ──
  // liveOpen 與 isPublic 是兩回事：isPublic 是議事公開頁的長期公開，
  // liveOpen 只在開會當下開啟，讓與會人憑連結看到「現在念到哪一案」。
  liveOpen         Boolean            @default(false)
  liveProposalId   String? // 目前進行中的提案（Proposal.id）；null＝尚未開始或已休息
  livePresent      Int? // 點名後的出席人數
  liveTotal        Int? // 議員總額
  liveTotalBasis   String? // 本次採用的總額定義：'2.3-4-2' 或 '2.0-13-1'（兩條衝突，須逐次記錄）
  liveNote         String? // 主席公告（如「休息十分鐘」），純文字
  liveUpdatedAt    DateTime? // 最後一次人工操作時間，供與會人判斷畫面是否卡住
  // 點名勾選的出席議員（Recipient.id[]）。有名冊時 livePresent＝這份名單的人數；
  // 線上表決開票時以這份名單為「可投票者」快照。NULL＝本場沒用名冊點名（只填數字）。
  liveAttendeeIds  Json?
  createdById      String // User.id（幹部）
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  proposals        Proposal[]
  agendaItems      AgendaItem[]
  notices          MeetingNotice[]
  reminders        MeetingReminder[]
  milestones       MeetingMilestone[]
  votes            Vote[]

  @@index([session, meetingAt])
}

model Proposal {
  id           String  @id @default(cuid())
  meetingId    String
  meeting      Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  serialNo     Int // 附件序 / 案號（2、3…）
  section      String // 報告事項 / 討論事項 / 選舉事項 / 臨時動議
  title        String // 案由
  proposer     String? // 提案人 / 提案單位
  explanation  String? @db.Text // 說明
  resolution   String? @db.Text // 決議（會後補）
  // 程序委員會審核狀態。法源：2.3《議會暨常會職權行使法》§9②「應先送程序委員會」。
  // pending（待審，預設）/ passed（通過）/ rejected（不列入議程）。
  // 議程只排除 rejected；pending 照舊會出現，故既有資料行為完全不變。
  reviewStatus String  @default("pending")
  // 議案類型，對應 data/vote-rules.json 的 id（如 consent／reconsider／impeach）。
  // 承辦於擬案時選定，決定會中要套哪一條法定表決方式與門檻。
  // nullable：未選＝未指定，系統不代為歸類（人在迴路）。
  matterType   String?
  fileUrl      String? // 附件連結（R2 待設定前先用雲端硬碟/URL）
  order        Int     @default(0)

  @@index([meetingId])
}

model AgendaItem {
  id         String  @id @default(cuid())
  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  section    String // 分節（會議規範：報告事項/討論事項/選舉事項/臨時動議…）
  order      Int
  title      String
  body       String? @db.Text
  proposalId String? // 對應提案時連結，可回溯

  @@index([meetingId])
}

model Recipient {
  id              String   @id @default(cuid())
  session         Int
  name            String
  email           String
  roleTag         String // 議員 / 列席 / 旁聽 / 祕書處
  active          Boolean  @default(true)
  // 議員名冊（完整資料；非議員之列席/旁聽/祕書處留空）。皆屬個資，永不進公開路由。
  district        String? // 選區：全校不分區 / 全校原住民不分區 / 碩博士不分區 / 系選區(系名)
  department      String? // 科系
  grade           String? // 年級（原文保真，如「二年級」）
  studentId       String? // 學號（議員唯一鍵，供冪等匯入）
  phone           String? // 手機
  // 議員專屬投票連結的版本。連結＝HMAC(AUTH_SECRET, id＋版本)，不存連結本身；
  // 「作廢重發」把版本加一，舊連結即失效（見 lib/meetings/vote-link.ts）。
  voteLinkVersion Int      @default(1)
  createdAt       DateTime @default(now())

  @@unique([session, studentId]) // 同屆同學號唯一；studentId 為 NULL 的非議員列不受限（PG 視 NULL 互異）
  @@index([session, active])
}

model MeetingNotice {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind         String // notice（開會通知）/ agenda（會議通知含議程）
  subject      String // 套版生成主旨
  bodyText     String   @db.Text // 套版生成內文
  bodyHtml     String?  @db.Text // Gmail 相容 HTML 版（見 lib/meetings/notice.ts）。
  //                             可為 NULL：本欄位之前建立的通知照舊只有純文字，行為不變。
  //                             不做回填——回填等於用 regex 反推標記，誤標了沒人會發現。
  recipientIds Json // 勾選收件人快照（Recipient.id[]）
  status       String   @default("draft") // draft / sent（sent 僅人工回記，系統不觸發送出）
  createdById  String
  createdAt    DateTime @default(now())

  @@index([meetingId])
}

model MeetingReminder {
  id         String    @id @default(cuid())
  meetingId  String
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  offsetDays Int // 會前幾天
  fireAt     DateTime // meetingAt - offset
  channel    String    @default("inapp") // inapp（先做）/ email_draft
  sentAt     DateTime?

  @@index([fireAt])
}

model MeetingMilestone {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String // 「財務委員會」「資格審查委員會」等
  at        DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([meetingId])
}

// ── 線上表決（現場議事的延伸，見 lib/meetings/voting.ts）──
// 無記名（secret=true）：只記「誰投過」（VoteVoter）與各選項總數（VoteOption.count），
//   資料庫裡沒有任何一列記著「誰投了哪一項」。
// 記名（secret=false）：另寫 VoteBallot（誰投了哪一項），看板與公開頁列名。
// 沒投票的出席議員即為廢票（2026-09-29 議會決定：同意／不同意兩個選項，可以不投）。

model Vote {
  id          String       @id @default(cuid())
  meetingId   String
  meeting     Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  proposalId  String? // 對應議案；選舉或未列入議程的事項可不掛
  kind        String // motion（同意／不同意）/ election（選人）
  secret      Boolean // true＝無記名投票、false＝記名投票
  title       String // 表決事項，預設帶案由
  seats       Int? // election 的應選名額，僅供顯示；當選由主席宣布
  matterType  String? // 開票當下議案類型（VoteRule.id）快照，事後可查依據
  status      String       @default("open") // open / closed / voided
  eligibleIds Json // 開票當下點名出席的議員（Recipient.id[]）；只有這份名單能投
  openedById  String // User.id
  openedAt    DateTime     @default(now())
  closedAt    DateTime?
  options     VoteOption[]
  voters      VoteVoter[]
  ballots     VoteBallot[]

  @@index([meetingId])
}

model VoteOption {
  id      String       @id @default(cuid())
  voteId  String
  vote    Vote         @relation(fields: [voteId], references: [id], onDelete: Cascade)
  label   String // 同意／不同意，或候選人姓名
  order   Int
  count   Int          @default(0) // 得票數（無記名表決只留這個數字）
  ballots VoteBallot[]

  @@index([voteId])
}

/// 已投票者。只記「投過了」，不記投了什麼；主鍵擋重複投票。
model VoteVoter {
  voteId      String
  vote        Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  recipientId String

  @@id([voteId, recipientId])
}

/// 記名表決的每一張票。無記名表決不寫這張表。
model VoteBallot {
  voteId      String
  vote        Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  recipientId String
  optionId    String
  option      VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([voteId, recipientId])
  @@index([optionId])
}
