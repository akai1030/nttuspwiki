{
  "$說明": "設計 tokens 的單一來源（規則見 DESIGN.md）。tailwind.config.ts 從這裡讀 class 名稱；scripts/design-check.mjs 從這裡讀哪些值算合規。瀏覽器讀的是 styles/tokens.css 的 CSS 變數，有 var 的項目 value 必須跟那份一字不差（npm run test:design 會比對）。改值兩份一起改。加新值先讀 DESIGN.md「要加新值時」。",

  "breakpoints": {
    "$說明": "斷點（DESIGN-SYSTEM §5）。Tailwind 的 hero:、rd: 前綴",
    "hero": { "value": "860px", "use": "首頁、索引頁：寬於此才排多欄" },
    "rd": { "value": "1000px", "use": "條文閱讀器：寬於此才出現左側目錄與右側邊註" }
  },

  "fontFamily": {
    "$說明": "明體讀法、黑體操作（DESIGN-SYSTEM §2）。中文小字一律黑體，不用等寬",
    "serif": { "var": "--serif", "value": "\"Noto Serif TC\", serif", "use": "大標、法規名、條名、條文正文" },
    "sans": { "var": "--sans", "value": "\"Noto Sans TC\", sans-serif", "use": "中文介面、內文、所有中文小字" },
    "ui": { "var": "--ui", "value": "\"Space Grotesk\", \"Noto Sans TC\", sans-serif", "use": "大數字、英文標籤、統計" },
    "mono": { "var": "--mono", "value": "\"Geist Mono\", monospace", "use": "條號、日期、代碼（只給拉丁字母與數字）" }
  },

  "fontWeight": {
    "$說明": "Tailwind 內建的這五個。app/layout.tsx 載入的字重：明體 400–900、黑體 400/500/700、Space Grotesk 400–700、Geist Mono 400/500。不用 100–300 細體與 800（DESIGN-SYSTEM §2.1 第 4 條）",
    "normal": { "value": "400", "use": "內文" },
    "medium": { "value": "500", "use": "小字重點、按鈕、導覽" },
    "semibold": { "value": "600", "use": "條名、站名（明體）" },
    "bold": { "value": "700", "use": "標題" },
    "black": { "value": "900", "use": "法規名、首頁大字（只有明體有 900）" }
  },

  "fontSize": {
    "$說明": "7 級（level 1–7）。variantOf 是同一級的變體：字級一樣，行高、字重或字距不同。deprecated 是舊值：Tailwind 照樣產生（現有畫面不變），檢查程式把用到它的地方記進基準，只准變少。class 名稱沿用原本的（text-h2 是每頁的 H1），改名要動到每一頁，不在這支 PR。小字叫 caption 不叫 meta：避免跟色名 meta 撞成同一個 .text-meta。",
    "h2": {
      "level": 1,
      "var": "--fs-h2",
      "value": "clamp(28px, 4vw, 44px)",
      "lineHeight": "1.1",
      "fontWeight": "700",
      "font": "serif",
      "px": "手機 28 → 桌機 44",
      "use": "每頁的 H1（一頁一個）、首頁的區塊大標"
    },
    "h4": {
      "level": 2,
      "var": "--fs-h4",
      "value": "21px",
      "lineHeight": "1.3",
      "fontWeight": "600",
      "font": "serif",
      "px": "21",
      "use": "卡片標題、小節標題"
    },
    "art-name": {
      "level": 3,
      "var": "--fs-art-name",
      "value": "19px",
      "lineHeight": "1.5",
      "fontWeight": "600",
      "font": "serif",
      "px": "19",
      "use": "條名、列表裡的項目名稱（會議名、搜尋結果）"
    },
    "art-body": {
      "level": 4,
      "var": "--fs-art-body",
      "value": "17px",
      "lineHeight": "2.05",
      "font": "serif",
      "px": "17",
      "use": "條文正文"
    },
    "body": {
      "level": 5,
      "var": "--fs-body",
      "value": "16px",
      "lineHeight": "1.75",
      "font": "sans",
      "px": "16",
      "use": "內文、表單"
    },
    "caption": {
      "level": 6,
      "var": "--fs-meta",
      "value": "12.5px",
      "lineHeight": "1.6",
      "font": "sans",
      "px": "12.5",
      "use": "小字 meta：日期、說明、標籤。中文小字的下限（DESIGN-SYSTEM §2.1），顏色用 text-meta 以上"
    },
    "chip": {
      "level": 7,
      "var": "--fs-chip",
      "value": "11px",
      "lineHeight": "1",
      "font": "ui",
      "px": "11",
      "use": "徽章、拉丁字母標籤（要加字距）。不放中文"
    },

    "lede": {
      "variantOf": "body",
      "var": "--fs-lede",
      "value": "16px",
      "lineHeight": "1.9",
      "font": "sans",
      "px": "16",
      "use": "頁首導言（跟 body 一樣大，行高較鬆）"
    },
    "brand": {
      "variantOf": "body",
      "var": "--fs-brand",
      "value": "16px",
      "lineHeight": "1.2",
      "fontWeight": "600",
      "font": "serif",
      "px": "16",
      "use": "頁首站名"
    },
    "note-label": {
      "variantOf": "caption",
      "var": "--fs-note-label",
      "value": "12.5px",
      "lineHeight": "1.2",
      "letterSpacing": "0.06em",
      "fontWeight": "700",
      "font": "sans",
      "px": "12.5",
      "use": "閱讀器邊註的標籤（參照、沿革、時程）"
    },
    "note": {
      "variantOf": "caption",
      "var": "--fs-note",
      "value": "12.5px",
      "lineHeight": "1.65",
      "font": "sans",
      "px": "12.5",
      "use": "閱讀器邊註的內文"
    },
    "cat-en": {
      "variantOf": "chip",
      "var": "--fs-cat-en",
      "value": "11px",
      "lineHeight": "1",
      "letterSpacing": "0.12em",
      "fontWeight": "500",
      "font": "ui",
      "px": "11",
      "use": "分類列的英文小標"
    },

    "hero-org": {
      "deprecated": "首頁 hero 專用（clamp 30→76px）。招牌字只准留在首頁；要不要保留成例外待昀楷確認",
      "var": "--fs-hero-org",
      "value": "clamp(30px, 5.4vw, 76px)",
      "lineHeight": "1.04",
      "fontWeight": "700"
    },
    "hero-sys": {
      "deprecated": "首頁 hero 專用（clamp 56→154px）。招牌字只准留在首頁；要不要保留成例外待昀楷確認",
      "var": "--fs-hero-sys",
      "value": "clamp(56px, 10.5vw, 154px)",
      "lineHeight": "1.04",
      "letterSpacing": "0.05em",
      "fontWeight": "900"
    },
    "hero-en": {
      "deprecated": "首頁 hero 英文外框字（clamp 20→46px）。招牌字只准留在首頁；要不要保留成例外待昀楷確認",
      "var": "--fs-hero-en",
      "value": "clamp(20px, 3.2vw, 46px)",
      "lineHeight": "1",
      "letterSpacing": "0.03em",
      "fontWeight": "700"
    },
    "law-title": {
      "deprecated": "40px，條文閱讀頁的法規名。建議改用 text-h2（桌機 44px），跟其他頁的 H1 同一級",
      "var": "--fs-law-title",
      "value": "40px",
      "lineHeight": "1.1",
      "letterSpacing": "0.01em",
      "fontWeight": "900"
    },
    "bignum": {
      "deprecated": "32px，首頁統計大數字。建議併進 h2 或保留成首頁例外，待確認",
      "var": "--fs-bignum",
      "value": "32px",
      "lineHeight": "1",
      "letterSpacing": "-0.01em",
      "fontWeight": "700"
    },
    "row-num": {
      "deprecated": "22px，法規列的編號。建議改 text-h4（21px）",
      "var": "--fs-row-num",
      "value": "22px",
      "lineHeight": "1"
    },
    "row-name": {
      "deprecated": "20px，法規列的法規名。建議改 text-h4（21px）或 text-art-name（19px）",
      "var": "--fs-row-name",
      "value": "20px",
      "lineHeight": "1.3",
      "fontWeight": "500"
    },
    "cat-label": {
      "deprecated": "18px，分類標籤。建議改 text-art-name（19px）",
      "var": "--fs-cat-label",
      "value": "18px",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em",
      "fontWeight": "700"
    },
    "chap": {
      "deprecated": "15px，閱讀器目錄的章名。建議改 text-body（16px）",
      "var": "--fs-chap",
      "value": "15px",
      "lineHeight": "1.4",
      "letterSpacing": "0.3em",
      "fontWeight": "700"
    },
    "nav": {
      "deprecated": "14px，頁首導覽。建議改 text-body（16px）或 text-caption（12.5px），待確認",
      "var": "--fs-nav",
      "value": "14px",
      "lineHeight": "1",
      "fontWeight": "500"
    },
    "code": {
      "deprecated": "13px，條號、日期等等寬小字。建議改 text-caption（12.5px）",
      "var": "--fs-code",
      "value": "13px",
      "lineHeight": "1.5"
    },
    "eyebrow": {
      "deprecated": "11.5px，頁首英文 kicker。建議改 text-chip（11px）",
      "var": "--fs-eyebrow",
      "value": "11.5px",
      "lineHeight": "1",
      "letterSpacing": "0.13em"
    }
  },

  "letterSpacing": {
    "$說明": "中文字距 0–.01em、不加大；拉丁大寫標籤 .08–.2em（DESIGN-SYSTEM §2.1 第 3 條）。另可用 Tailwind 內建的 tracking-wide 等（這裡不覆寫內建名稱）。分類英文小標的 .12em 寫在 fontSize.cat-en 裡",
    "snug": { "value": "0.02em", "use": "中文標題微調" },
    "tag": { "value": "0.06em", "use": "標籤" },
    "label": { "value": "0.08em", "use": "拉丁標籤" },
    "eyebrow": { "value": "0.13em", "use": "英文 eyebrow" },
    "kicker": { "value": "0.2em", "use": "英文 kicker" },
    "chap": { "value": "0.3em", "use": "閱讀器章名" }
  },

  "colors": {
    "$說明": "class 名稱 → CSS 變數。分組只是說明用途，class 名稱不帶組名（text-ink、bg-paper2、border-line）。一個顏色可以跨組用（accent 也是按鈕底），但新的地方照組別挑。white 是 Tailwind 內建，列在這裡是讓檢查程式認得 #fff。tailwind: false 的只給 CSS 用，沒有 class。",
    "text": {
      "$說明": "文字色。小字（≤13px）一律 meta 以上；muted 只給 ≥24px 大字或非文字",
      "ink": { "var": "--ink", "value": "#17181c", "use": "主文字、深色標籤" },
      "body-ink": { "var": "--body-ink", "value": "#33332b", "use": "條文正文" },
      "lede-ink": { "var": "--lede-ink", "value": "#43433c", "use": "導言" },
      "meta": { "var": "--meta", "value": "#5c5b54", "use": "小字（對比 ≥ 4.5:1，不可更淺）" },
      "muted": { "var": "--muted", "value": "#807f78", "use": "次要。對 paper 只有 3.85:1，只給 ≥24px 大字或非文字" },
      "ref-ink": { "var": "--ref-ink", "value": "#39468a", "use": "參照預覽卡文字" },
      "warn-ink": { "var": "--warn-ink", "value": "#a8341f", "use": "「有疑慮」判定文字" },
      "white": { "builtin": true, "value": "#ffffff", "use": "實色底（accent、ink、分類色）上的字" }
    },
    "bg": {
      "$說明": "底色。一般頁面一律亮底",
      "paper": { "var": "--paper", "value": "#fbfaf6", "use": "頁面暖白底" },
      "paper2": { "var": "--paper2", "value": "#f1efe7", "use": "次級面（閱讀區、hover）" },
      "cloud": { "var": "--cloud", "value": "#e8e9e4", "use": "更淡的分隔面" },
      "ref-surface": { "var": "--ref-surface", "value": "#f4f6ff", "use": "參照預覽卡底" },
      "toc-on": { "var": "--toc-on", "value": "#eef1ff", "use": "目錄、連結的當前態底" },
      "warn-surface": { "var": "--warn-surface", "value": "#fdeee9", "use": "「有疑慮」判定 pill 底" },
      "paper-blur": { "var": "--paper-blur", "value": "rgba(251, 250, 246, 0.86)", "use": "sticky 頂列半透明底（配 backdrop-blur）" }
    },
    "accent": {
      "$說明": "靛藍是唯一主色；accent2 只給警示與沿革標記",
      "accent": { "var": "--accent", "value": "#243fb5", "use": "連結、當前態、主按鈕、參照" },
      "accent-soft": { "var": "--accent-soft", "value": "#3b54c8", "use": "hover" },
      "accent2": { "var": "--accent2", "value": "#c7442e", "use": "磚紅：警示、沿革標記，少量" }
    },
    "line": {
      "$說明": "線與框",
      "line": { "var": "--line", "value": "rgba(23, 24, 28, 0.14)", "use": "一般分隔線、框（border 不寫顏色時就是它）" },
      "line-soft": { "var": "--line-soft", "value": "rgba(23, 24, 28, 0.07)", "use": "更淡的分隔線" },
      "ref-border": { "var": "--ref-border", "value": "#d5ddff", "use": "參照預覽卡框" },
      "warn-border": { "var": "--warn-border", "value": "#f0c3b6", "use": "「有疑慮」判定 pill 框" },
      "sch-line": { "var": "--sch-line", "value": "#1f9e75", "use": "時程邊註左邊色" }
    },
    "category": {
      "$說明": "五類法規識別色，只用於分類標籤與圓點",
      "cat-charter": { "var": "--cat-charter", "value": "#243fb5", "use": "最高章程" },
      "cat-legis": { "var": "--cat-legis", "value": "#17181c", "use": "立法" },
      "cat-exec": { "var": "--cat-exec", "value": "#c7442e", "use": "行政" },
      "cat-judic": { "var": "--cat-judic", "value": "#5b3e9b", "use": "司法" },
      "cat-elect": { "var": "--cat-elect", "value": "#1f7a54", "use": "選舉" }
    },
    "semantic": {
      "$說明": "檢核、時程、參照的語意色",
      "ok": { "var": "--ok", "value": "#0f6e56", "use": "通過" },
      "warn": { "var": "--warn", "value": "#993c1d", "use": "警示" },
      "sch": { "var": "--sch", "value": "#0f6e56", "use": "時程" },
      "ref": { "var": "--ref", "value": "#243fb5", "use": "參照" }
    },
    "decor": {
      "$說明": "裝飾用的半透明色",
      "glyph": { "var": "--glyph", "value": "rgba(23, 24, 28, 0.045)", "use": "首頁大「法」浮水印" },
      "stroke": { "var": "--stroke", "value": "rgba(23, 24, 28, 0.3)", "tailwind": false, "use": "首頁英文外框字描邊（globals.css 的 .stroke-text）" }
    }
  },

  "borderColor": {
    "$說明": "border 不寫顏色時用哪個色名",
    "DEFAULT": { "color": "line" }
  },

  "spacing": {
    "$說明": "版面用的間距。元件內的小間距用 Tailwind 內建級距（4px 一格：gap-2＝8px、p-4＝16px…），不寫 p-[19px] 這類任意值",
    "section": { "var": "--sp-section", "value": "118px", "use": "區塊上下 padding（桌機）" },
    "section-sm": { "var": "--sp-section-sm", "value": "60px", "use": "區塊上下 padding（手機）" },
    "wrap": { "var": "--sp-wrap-pad", "value": "44px", "use": "容器左右 padding（桌機）" },
    "wrap-sm": { "var": "--sp-wrap-pad-sm", "value": "22px", "use": "容器左右 padding（手機）" },
    "card": { "var": "--sp-card", "value": "30px", "use": "卡片 padding" }
  },

  "maxWidth": {
    "$說明": "內容寬度只有三種。頁面容器 mx-auto 配其中一個",
    "wrap": { "var": "--wrap-max", "value": "1180px", "use": "一般頁面容器" },
    "wrap-reader": { "var": "--wrap-max-reader", "value": "1320px", "use": "條文閱讀頁容器" },
    "reader": { "var": "--reader-max", "value": "730px", "use": "單欄閱讀框、長文、導言" }
  },

  "borderRadius": {
    "$說明": "以直角為主，只在小處微圓",
    "sm": { "var": "--radius-sm", "value": "3px", "use": "按鈕、標籤、輸入框" },
    "full": { "builtin": true, "value": "9999px", "use": "圓點、進度點" },
    "none": { "builtin": true, "value": "0", "use": "直角" }
  },

  "boxShadow": {
    "$說明": "不用陰影、漸層、發光（DESIGN-SYSTEM §7）。層次靠線（border-line）與底色（bg-paper2）",
    "none": { "builtin": true, "value": "none", "use": "唯一允許的值" }
  }
}
